# Учетные данные от hh.ru
HH_LOGIN=your_email@example.com
HH_PASSWORD=your_password

# ID резюме (можно указать одно или несколько через запятую)
# Вариант 1: Одно резюме (для обратной совместимости)
RESUME_ID=your_resume_id

# Вариант 2: Несколько резюме (будут подниматься поочередно)
# Резюме будут подниматься по кругу: первое, второе, третье, затем снова первое
# Пример: RESUME_IDS=resume_id_1,resume_id_2,resume_id_3
# RESUME_IDS=your_resume_id_1,your_resume_id_2,your_resume_id_3

# Настройки расписания (в формате HH:MM)
# Используется если планировщик настроен на запуск по времени, а не каждые N часов
SCHEDULE_TIME=09:00

# Настройки для веб-автоматизации
HEADLESS_BROWSER=true      # true для сервера, false для локальной разработки
BROWSER_TYPE=chromium      # chromium или chrome (рекомендуется chromium для серверов)

# Опционально: OAuth токен для API (если доступен)
# HH_ACCESS_TOKEN=your_oauth_token
